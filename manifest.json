{
  "manifest_version": 3,
  "name": "Gemini Chat Organizer",
  "version": "0.1.0",
  "description": "Inbox-style bulk management for Gemini chats: multi-select, shift-click range select, and bulk delete.",
  "action": {
    "default_title": "Toggle Gemini Chat Organizer"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["https://generativelanguage.googleapis.com/*"],
  "permissions": ["storage"],
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
